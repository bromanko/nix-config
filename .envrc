use flake

# Load local secrets/overrides from a gitignored dotenv file. Use direnv's
# parser explicitly so this also works when .env.local is FIFO-backed.
dotenv_or_fifo_if_exists() {
  local path="$1"

  watch_file "$path"
  if [ ! -e "$path" ]; then
    return 0
  fi

  eval "$("$direnv" dotenv bash "$path")"
}

dotenv_or_fifo_if_exists .env.local
